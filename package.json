{
  "name": "socially-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "Socially social media platform decomposed into microservices",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:gateway": "npm --workspace=services/api-gateway run dev",
    "dev:realtime": "npm --workspace=services/realtime-service run dev",
    "dev:auth": "npm --workspace=services/auth-service run dev",
    "dev:user": "npm --workspace=services/user-service run dev",
    "dev:post": "npm --workspace=services/post-service run dev",
    "dev:chat": "npm --workspace=services/chat-service run dev",
    "dev:notification": "npm --workspace=services/notification-service run dev",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "microservices",
    "nodejs",
    "express",
    "socketio",
    "redis",
    "mongodb"
  ],
  "author": "divyesh odedara",
  "license": "ISC"
}
