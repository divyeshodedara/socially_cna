# Environment Configuration
NODE_ENV=development
PORT=3000

# Base MongoDB connection string (each service appends its logical database name: socially_auth, socially_users, etc.)
DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/socialMedia?retryWrites=true&w=majority

# Optional individual database URLs for distinct clusters or overrides
# AUTH_DB_URL=
# USER_DB_URL=
# POST_DB_URL=
# CHAT_DB_URL=
# NOTIFICATION_DB_URL=

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d
COOKIE_EXPIRES_IN=86400000

# Client URL
FRONTEND_URL=http://localhost:5173

# Redis (for Pub/Sub and caching)
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Brevo (Email OTP)
BREVO_API_KEY=your_brevo_api_key_here

# AWS S3 Storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=socially-media
S3_PUBLIC_URL=https://socially-media.s3.ap-south-1.amazonaws.com
